# ============================================================
#  VetCare · Variables de entorno
#  Copia este archivo como .env y completa los valores.
#  El .env real NUNCA se versiona (está en .gitignore).
# ============================================================

# --- Obligatorias: la app se niega a arrancar si faltan ---------------------
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Solo PostgreSQL. La app rechaza cualquier otra URL (sqlite, mysql...).
DATABASE_URL=postgresql+psycopg://vetcare:CAMBIA_ESTA_CLAVE@localhost:5432/vetcare

# --- Entorno ----------------------------------------------------------------
# true en producción: Gunicorn corre detrás de Nginx y la IP real del cliente
# llega en X-Forwarded-For (necesario para el límite de intentos de login).
BEHIND_PROXY=false
# true en producción (solo HTTPS). En local déjalo en false o no podrás iniciar sesión.
SESSION_COOKIE_SECURE=false
# Horas de vida de la sesión antes de pedir login de nuevo.
SESSION_HOURS=12

# --- Archivos subidos (fotos de mascotas, consentimientos, resultados) -------
UPLOAD_FOLDER=static/uploads
MAX_UPLOAD_MB=20

# --- Registro (logs) --------------------------------------------------------
LOG_LEVEL=INFO
# Vacío = solo consola (cómodo en desarrollo).
LOG_FILE=logs/vetcare.log

# --- Pruebas (opcional) -----------------------------------------------------
# Base separada para pytest; sus tablas se crean y destruyen en cada corrida.
# TEST_DATABASE_URL=postgresql+psycopg://vetcare:CAMBIA_ESTA_CLAVE@localhost:5432/vetcare_test

# --- Mensualidad Servidor / Licencia Software -------------------------------
VALOR_MENSUALIDAD_SERVIDOR=100.000
PIN_CONFIRMACION_SERVIDOR=9876
FECHA_INICIO_COBRO_SERVIDOR=2026-10-01


